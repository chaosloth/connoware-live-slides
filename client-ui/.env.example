# ================================================
# Client UI Environment Variables (Example)
# ================================================

# API Base URL (points to Twilio Serverless Functions)
# Use https://your-twilio-domain.twil.io for production
# Use http://localhost:3001 for local development
NEXT_PUBLIC_API_BASE=http://localhost:3001

# Frontend Configuration
NEXT_PUBLIC_SEGMENT_API_KEY=your_segment_api_key
NEXT_PUBLIC_PRESENTATIONS_MAP_NAME=Presentations
NEXT_PUBLIC_ASSISTANT_SID=

# NEXT_PUBLIC_SERVERLESS_URL has been consolidated with NEXT_PUBLIC_API_BASE
