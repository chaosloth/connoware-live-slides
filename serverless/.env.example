# ================================================
# Connoware Live Slides Environment Variables (Example)
# ================================================

#
# Twilio Account Credentials
#
ACCOUNT_SID=
AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=

#
# Twilio Services
#
SYNC_SERVICE_SID=
CHAT_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_TWIML_APP_SID=

#
# Flex Workflow (if needed)
#
WORKSPACE_SID=
WORKFLOW_SID=

#
# OpenAI API Key
#
OPENAI_API_KEY=

#
# Authentication
#
JWT_SECRET=your-secret-key-change-this-in-production
AUTHORIZED_PHONE_NUMBERS=+1234567890,+10987654321

#
# Cross-origin settings
#
UI_BASE_URL=https://your-frontend-domain.com
